+    let _ ← (lazyPartsLoadPriv ref m n).toBaseIO
+  let s ← ref.get
+  return s.overlay.find? n <|> c?
+
+/--
+Lazy parts: entries of extension `extName` for module `m` served from a lazily loaded part
+(`.olean.private` when `ir = false`, `.ir` when `ir = true`), loading the part on first use;
+`none` means "use the eagerly imported entries".
