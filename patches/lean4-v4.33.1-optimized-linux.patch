+#ifdef LEAN_OLEAN_ADDRESS_RESERVE
+namespace {
+/*
+Background. `lean_compacted_region_read` maps every `.olean*` / `.ir*` part at the pseudo-random
+47-bit address stored in its header (`olean_header::base_addr`, a hash of the module name).
+`import Mathlib` performs ~52,000 such hinted `mmap`s. XNU's `vm_map_enter` locates the free
+range ("hole") containing a caller-supplied address by walking a singly-linked, address-sorted
+hole list from the bottom of the address space, and every mapping dropped into a fresh part of the
+space adds a hole to that list. With addresses spread uniformly over the 47-bit space this makes
+the k-th mapping cost O(k): ~7 s of kernel time for a Mathlib import on an M2 Pro, i.e. about half
+of the warm wall time. (Linux locates gaps with an augmented red-black tree and does not have this
+problem; the code below is compiled on macOS only.)
+
+Fix. On first use, reserve every free range of the address space above `floor_addr` with a single
+`PROT_NONE` anonymous mapping each (a handful of `mmap`s covering ~126 TB of virtual space; they
+are never touched, so they cost no memory). Afterwards the hole list contains only the holes below
+`floor_addr` plus the few not-yet-mapped fragments, and a region file whose range lies inside a
+reservation is mapped with `MAP_FIXED` *over* the reservation: the kernel carves the file mapping
+out of the reservation entry (an O(log n) red-black-tree lookup) and no hole is ever created.
+Ranges are tracked in user space so that two files whose ranges overlap (a base-address collision)
+are handled exactly as today: the second one does not get its address and falls back to
+`malloc` + `read` + relocation. Files below `floor_addr` (~1 % of a Mathlib closure) and any file
+whose range is not fully reserved keep using the original hinted `mmap`.
+
+The reservation leaves the bottom `floor_addr` bytes (1 TB) alone for the heap, thread stacks,
+dyld, and the system allocator; mimalloc's aligned-allocation hints (2–30 TB) may now be refused
+by the kernel, which mimalloc handles by falling back to an unhinted `mmap` (`unix_mmap`), so no
+allocation can fail because of the reservation.
+
+Semantics are unchanged: which regions land at their saved address (and therefore take the
+relocation-free fast path in `region_reader::read`) is decided exactly as before — only the kernel
+bookkeeping differs. `LEAN_MMAP_RESERVE=0` in the environment restores the original behaviour
+(useful for A/B measurements).
+*/
+class olean_address_reserver {
+    std::mutex m_mutex;
+    bool m_initialized = false;
+    bool m_enabled = false;
+    // Reserved (PROT_NONE) address ranges that are not yet occupied by a region: start -> end.
+    // Disjoint, sorted, coalesced.
+    std::map<uintptr_t, uintptr_t> m_free;
+    uintptr_t m_page_size = 0;
+
+    static constexpr uintptr_t floor_addr = uintptr_t(1) << 40;              // 1 TB
+    // `base_addr`s are generated modulo 0x7f0000000000 (`mk_base_addr`); leave room for the file.
+    static constexpr uintptr_t ceil_addr  = uintptr_t(0x7f0000000000) + (uintptr_t(1) << 32);
+
+    void insert_free(uintptr_t s, uintptr_t e) {
+        // coalesce with neighbours
+        auto it = m_free.lower_bound(s);
+        if (it != m_free.begin()) {
+            auto prev = std::prev(it);
+            if (prev->second == s) { s = prev->first; m_free.erase(prev); }
+        }
+        it = m_free.find(e);
+        if (it != m_free.end()) { e = it->second; m_free.erase(it); }
+        m_free[s] = e;
+    }
+
+    // Reserve the free range [s, e). We deliberately do not use `MAP_FIXED` here: another thread
+    // may have mapped something into the hole since we enumerated it, and `MAP_FIXED` would
+    // silently replace it. With a plain hint the kernel returns a different address in that case
+    // and we simply retry the enumeration from `s`.
+    bool reserve(uintptr_t s, uintptr_t e) {
+        void * p = mmap(reinterpret_cast<void *>(s), e - s, PROT_NONE, MAP_ANON | MAP_PRIVATE | MAP_NORESERVE, -1, 0);
+        if (p == MAP_FAILED) return false;
+        if (reinterpret_cast<uintptr_t>(p) != s) { munmap(p, e - s); return false; }
+        insert_free(s, e);
+        // Everything that will ever be accessible inside [s, e) is a compacted region mapped by
+        // `map_file`: tell the runtime so that it can recognise pointers into regions by address
+        // (`lean_is_in_persistent_address_range`), without dereferencing them.
+        lean_register_persistent_address_range(s, e);
+        return true;
+    }
+
+    void initialize() {
+        m_initialized = true;
+        if (char const * v = getenv("LEAN_MMAP_RESERVE")) {
+            if (v[0] == '0' && v[1] == '\0') return;
+        }
+        m_page_size = static_cast<uintptr_t>(getpagesize());
+        mach_port_t task = mach_task_self();
+        uintptr_t cursor = floor_addr;
+        int retries = 0;
+        while (cursor < ceil_addr) {
+            mach_vm_address_t addr = cursor;
+            mach_vm_size_t size = 0;
+            vm_region_basic_info_data_64_t info;
+            mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+            mach_port_t obj = MACH_PORT_NULL;
+            kern_return_t kr = mach_vm_region(task, &addr, &size, VM_REGION_BASIC_INFO_64,
+                                              reinterpret_cast<vm_region_info_t>(&info), &count, &obj);
+            if (obj != MACH_PORT_NULL) mach_port_deallocate(task, obj);
+            uintptr_t hole_s = cursor;
+            uintptr_t hole_e = kr == KERN_SUCCESS ? std::min<uintptr_t>(addr, ceil_addr) : ceil_addr;
+            if (hole_e > hole_s && !reserve(hole_s, hole_e)) {
+                // Something else got mapped there concurrently (or the kernel refused): re-scan
+                // this hole, but give up on it after a few attempts so that we cannot spin.
+                if (++retries < 8) continue;
+                retries = 0;
+            } else {
+                retries = 0;
+            }
+            if (kr != KERN_SUCCESS) break;
+            cursor = std::max<uintptr_t>(hole_e, static_cast<uintptr_t>(addr + size));
+        }
+        m_enabled = !m_free.empty();
+    }
+
+    bool covers(uintptr_t s, uintptr_t e, std::map<uintptr_t, uintptr_t>::iterator & it) {
+        it = m_free.upper_bound(s);
+        if (it == m_free.begin()) return false;
+        --it;
+        return it->first <= s && e <= it->second;
+    }
+
+public:
+    // Try to map `size` bytes of `fd` exactly at `base_addr` by carving the range out of a
+    // reservation. Returns the mapping (== `base_addr`) or `nullptr` when the range is not (fully)
+    // reserved-and-free or the `mmap` failed; the caller then uses the ordinary hinted path.
+    char * map_file(char * base_addr, size_t size, int fd) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_initialized) initialize();
+        if (!m_enabled) return nullptr;
+        uintptr_t s = reinterpret_cast<uintptr_t>(base_addr);
+        if (s % m_page_size != 0 || size == 0) return nullptr;
+        uintptr_t e = (s + size + m_page_size - 1) & ~(m_page_size - 1);
+        std::map<uintptr_t, uintptr_t>::iterator it;
+        if (!covers(s, e, it)) return nullptr;
+        void * p = mmap(base_addr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, fd, 0);
+        if (p == MAP_FAILED) return nullptr;
+        lean_always_assert(p == base_addr);
+        // carve [s, e) out of the free range
+        uintptr_t fs = it->first, fe = it->second;
+        m_free.erase(it);
+        if (fs < s) m_free[fs] = s;
+        if (e < fe) m_free[e] = fe;
+        return base_addr;
+    }
+
+    // Release a region mapping. If the range lies in the reserved part of the address space, turn
+    // it back into a `PROT_NONE` reservation (which unmaps the file) so that it stays usable by
+    // `map_file` and does not become a hole; otherwise plain `munmap`.
+    void unmap(char * buffer, size_t size) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        uintptr_t s = reinterpret_cast<uintptr_t>(buffer);
+        if (m_enabled && s >= floor_addr && s < ceil_addr && s % m_page_size == 0) {
+            uintptr_t e = (s + size + m_page_size - 1) & ~(m_page_size - 1);
+            void * p = mmap(buffer, e - s, PROT_NONE, MAP_ANON | MAP_PRIVATE | MAP_NORESERVE | MAP_FIXED, -1, 0);
+            if (p == buffer) { insert_free(s, e); return; }
+        }
+        lean_always_assert(munmap(buffer, size) == 0);
+    }
+};
