+/-!
+## Lazy parts: lazy loading of `.olean.private` and `.ir` parts for legacy (non-`module`) roots
+
+A root file without `module` imports every module at the `.private` level: the constant map is
+built from the `.olean.private` parts (private declarations, proof bodies, unexposed definition
+bodies) and the interpreter needs the `.ir` parts. Stock Lean maps all five files of every module
+eagerly. Here, `importModulesCore` reads only the `.olean` parts; `finalizeImport` then either
+loads the other parts eagerly (`LEAN_LAZY_PARTS=0`, or when no index is available) or registers them for
+on-demand loading:
+
+* `.ir` (`LEAN_LAZY_PARTS=ir` or `all`): loaded when the interpreter first asks for IR of that module
+  (`getModuleIREntries` of `Lean.IR.declMapExt`).
+* `.olean.private` (`LEAN_LAZY_PARTS=all`, the default): loaded when a constant of the module is looked up
+  whose exported `ConstantInfo` differs from the private one (a theorem/definition weakened to an
+  axiom), when a private-only name of the module is looked up, or when an extension in
+  `lazyPartsLazyExtNames` (extensions whose entries are only ever read per module) reads the module's
+  entries.
+
+What a legacy root needs *eagerly* but which only exists in the deferred parts — the code
+generator's auxiliary names (`extraConstNames`, for `const2ModIdx`), the `[init]` declarations, the
+names of private-only constants (for `const2ModIdx`) and the private-level entries of extensions
+whose `addImportedFn` consumes entries at import — is taken from an index file that is generated on
+the first (eager) import of a given module closure and cached in `$LEAN_LAZY_PARTS_INDEX_DIR`
+(default `~/.cache/lean-lazy-parts`). A production version would store this data in the eagerly loaded
+part of the module instead.
+-/
+
+/-- Per-module contents of the lazy-parts index. -/
+structure LazyPartsModIndex where
+  /-- `ModuleData.extraConstNames` of the `.ir` part. -/
+  extraConstNames  : Array Name := #[]
+  /-- Entries of the `.ir` part other than `Lean.IR.declMapExt` (`[init]` declarations, package). -/
+  irEntries        : Array (Name × Array EnvExtensionEntry) := #[]
+  /-- Names in the `.olean.private` constant table that are not in the `.olean` one. -/
+  privOnlyNames    : Array Name := #[]
+  /--
+  Indices into the `.olean` constant arrays in the order of the `.olean.private` constant table
+  (declaration order), so that `header.moduleData` lists the constants in the same order as stock
+  (`LazyDiscrTree`/`exact?` results depend on it).
+  -/
+  privOrder        : Array Nat := #[]
+  /--
+  Private-level entry arrays (copied) of extensions not in `lazyPartsLazyExtNames` that differ from the
+  exported-level ones; they replace the exported-level arrays in `ModuleData.entries`.
+  -/
+  privEagerEntries : Array (Name × Array EnvExtensionEntry) := #[]
+  deriving Inhabited
+
+/-- The lazy-parts index of a module closure (in `ModuleIdx` order). -/
+structure LazyPartsIndex where
+  moduleNames : Array Name := #[]
+  mods        : Array LazyPartsModIndex := #[]
+  deriving Inhabited
+
+/-- Lazy parts: per-module description of the parts that can be loaded on demand. -/
+structure LazyPartsLazyMod where
+  /-- `.olean.server`, `.olean.private` (chained on `privDeps`). -/
+  privFiles : Array System.FilePath := #[]
+  privDeps  : Array CompactedRegion := #[]
+  /-- `.ir.sig`, `.ir`. -/
+  irFiles   : Array System.FilePath := #[]
+  deriving Inhabited
+
+/-- Lazy parts: mutable lazy-loading state of one environment (kept outside the environment object, which
+is marked persistent). -/
+structure LazyPartsState where
+  lazyPrivate  : Bool := false
+  verbose      : Bool := false
+  moduleNames  : Array Name := #[]
+  mods         : Array LazyPartsLazyMod := #[]
+  /-- The eagerly built constant map (exported data), for duplicate resolution. -/
+  exported     : Std.HashMap Name ConstantInfo := {}
+  /-- Per module, the entries of its `.olean.private` part once loaded. -/
+  privEntries  : Array (Option (Std.HashMap Name (Array EnvExtensionEntry))) := #[]
+  /-- Per module, the entries of its `.ir` part once loaded. -/
+  irEntries    : Array (Option (Std.HashMap Name (Array EnvExtensionEntry))) := #[]
+  /-- Constants of the loaded `.olean.private` parts. -/
+  overlay      : PHashMap Name ConstantInfo := {}
+  numOverlay   : Nat := 0
+  /-- Regions loaded on demand (never freed; the frontend leaks the environment anyway). -/
+  regions      : Array CompactedRegion := #[]
+  numPrivLoads : Nat := 0
+  numIRLoads   : Nat := 0
+  deriving Inhabited
+
+builtin_initialize lazyPartsRegistry : IO.Ref (Array (IO.Ref LazyPartsState)) ← IO.mkRef #[]
+
+/--
+Extensions whose imported entries are consumed only per module through `getModuleEntries`
+(their `addImportedFn` ignores the entries), so that the private-level entries can be served on
+demand from the `.olean.private` part. Every other extension with private-level entries that differ
+from the exported ones gets the private arrays from the index at import time. `declMetaExt` is
+deliberately *not* in this list although it is lazy: `getIRPhases` consults it for every constant
+the interpreter evaluates, which would load the private part of every module with an initializer
+or a parser at import time.
+-/
+private def lazyPartsLazyExtNames : Std.HashMap Name Unit :=
+  let priv (mod n : Name) : Name := (Name.mkNum (`_private ++ mod) 0) ++ n
+  [`Lean.Compiler.LCNF.impureSigExt, `Lean.Compiler.LCNF.monoExt, `Lean.Compiler.LCNF.baseExt,
+   `Lean.Compiler.LCNF.UnreachableBranches.functionSummariesExt,
+   priv `Lean.ExtraModUses `Lean.extraModUses,
+   `Lean.declRangeExt, `Lean.docStringExt, `Lean.versoDocStringExt,
+   priv `Lean.DocString.Extension `Lean.moduleDocExt,
+   priv `Lean.DocString.Extension `Lean.inheritDocStringExt,
+   priv `Lean.DocString.Extension `Lean.versoModuleDocExt,
+   `Lean.Compiler.inlineAttrs, `Lean.Compiler.nospecializeAttr, `Lean.matchPatternAttr,
+   priv `Lean.Meta.Constructions.SparseCasesOn `Lean.Meta.sparseCasesOnInfoExt,
+   `Lean.Elab.Structural.eqnInfoExt, `Lean.Elab.WF.eqnInfoExt].foldl (·.insert · ()) {}
+
+private def lazyPartsDeclMapExtName : Name := `Lean.IR.declMapExt
+
+/-- `0`: everything eager (stock part loading); `1`: lazy `.ir`; `2`: lazy `.ir` and `.olean.private`. -/
+private def lazyPartsMode : IO Nat := do
+  match ← IO.getEnv "LEAN_LAZY_PARTS" with
+  | some "0" | some "off" => return 0
+  | some "ir" => return 1
+  | _ => return 2
+
+private def lazyPartsIndexDir : IO (Option System.FilePath) := do
+  if let some d ← IO.getEnv "LEAN_LAZY_PARTS_INDEX_DIR" then return some d
+  if let some h ← IO.getEnv "HOME" then return some (System.FilePath.mk h / ".cache" / "lean-lazy-parts")
+  return none
+
+
+/-!
+### Bounding the lazy-parts index directory
+
+Lazy parts keeps a directory of index files keyed on the import closure, and never deleted one. That is
+harmless when a project's files share a handful of headers — a 1,373-file project presents 213
+distinct closures and the directory converges — and it is a disk-filling defect when every
+compilation unit has its own closure, which is exactly the shape of a library build *from source*.
+
+(The tactic index used to keep such a directory too, and was much the worse offender: a from-source Mathlib
+build wrote 255 GiB of images to answer 216 lookups. It no longer writes anything at runtime — its
+image is a *shipped artefact*, built on request and only ever read at run time. See the tactic-index section
+below. These bounds are therefore the lazy-parts index's alone; the helpers stay generic because the shape — a keyed
+directory of large files — is not specific to lazy parts.)
+
+Three bounds, each configurable, each off the fast path:
+
+* a **free-space floor** (`LEAN_LAZY_PARTS_MIN_FREE`, default 10 GB): below it no new file is written, but
+  existing files are still read. One `statfs` per write attempt (a few microseconds against a write
+  that costs hundreds of milliseconds), so there is nothing to memoise;
+* a **size cap with LRU eviction** (`LEAN_LAZY_PARTS_MAX_SIZE`, default 5 GB — the figure `ccache` and
+  Gradle's build cache have used for caches of this shape, a convention rather than a measured
+  optimum). Enforced after each write by one `readDir` plus one `stat` per file;
+* an **admission threshold** (`LEAN_LAZY_PARTS_MIN_USES`, default **1**), the analogue of nginx's
+  `proxy_cache_min_uses`: a closure must have been seen this many times before its index is
+  written. At the default of 1 nothing changes — the first miss writes, as before. At 2 a
+  from-source build writes one empty marker file per closure and no indexes at all, because no
+  closure there ever recurs; the price is that a project whose files *do* share headers loses the
+  index on the first sighting of each closure, which is why 1 and not 2 is the default.
+
+Recency for the LRU is the newest mtime in the entry's group of files: the payload
+(`index-<key>.lazyparts`) and a one-byte `.used` stamp rewritten on every hit (~30 µs, against an import
+the index exists to make seconds faster).
+-/
+
+/--
+Free space in bytes on the filesystem holding `path`; `0` when the question cannot be answered,
+which every caller reads as "unknown, do not block".
+-/
+@[extern "lean_io_free_disk_space"]
+private opaque cacheFreeSpaceOf (path : @& String) : IO UInt64
+
+/-- The three bounds on a side-cache directory. `0` disables a bound. -/
+structure CacheBound where
+  /-- Stop writing when free space on the cache's filesystem is below this many bytes. -/
+  minFree : UInt64 := 0
+  /-- Evict least-recently-used entries to keep the directory below this many bytes. -/
+  maxSize : UInt64 := 0
+  /-- Write an entry only once its key has been seen this many times. -/
+  minUses : Nat := 1
+  deriving Inhabited
+
+private def cacheDigits (cs : List Char) : Nat :=
+  cs.foldl (fun a c => a * 10 + (c.toNat - '0'.toNat)) 0
+
+/-- `12`, `512K`, `10M`, `5G` (also `KB`/`MB`/`GB`, case-insensitive). `none` if unparsable. -/
+private def cacheParseSize (s : String) : Option UInt64 := Id.run do
+  let cs := s.toList.filter (!·.isWhitespace)
+  let digits := cs.takeWhile Char.isDigit
+  if digits.isEmpty then return none
+  let n := cacheDigits digits
+  let unit := String.ofList ((cs.drop digits.length).map Char.toLower)
+  let mult : Option Nat := match unit with
+    | "" | "b"          => some 1
+    | "k" | "kb" | "kib" => some 1024
+    | "m" | "mb" | "mib" => some (1024 * 1024)
+    | "g" | "gb" | "gib" => some (1024 * 1024 * 1024)
+    | "t" | "tb" | "tib" => some (1024 * 1024 * 1024 * 1024)
+    | _                  => none
+  match mult with
+  | none   => return none
+  | some m => return some (UInt64.ofNat (n * m))
+
+private def cacheReadBound (pfx : String) (defMinFree defMaxSize : UInt64) : IO CacheBound := do
+  let readSize (suffix : String) (dflt : UInt64) : IO UInt64 := do
+    match ← IO.getEnv (pfx ++ suffix) with
+    | none   => return dflt
+    | some v => return (cacheParseSize v).getD dflt
+  let minFree ← readSize "_MIN_FREE" defMinFree
+  let maxSize ← readSize "_MAX_SIZE" defMaxSize
+  let minUses ← match ← IO.getEnv (pfx ++ "_MIN_USES") with
+    | none   => pure 1
+    | some v =>
+      let ds := v.toList.filter (!·.isWhitespace)
+      pure (if ds.isEmpty || !ds.all Char.isDigit then 1 else cacheDigits ds)
+  return { minFree, maxSize, minUses }
+
+/-- Default bounds: a 10 GB free-space floor and a 5 GB directory cap. -/
+private def cacheDefaultMinFree : UInt64 := 10 * 1024 * 1024 * 1024
+private def cacheDefaultMaxSize : UInt64 := 5 * 1024 * 1024 * 1024
+
+/--
+Blocks a filesystem hands out even for a one-byte file. Marker files are one byte of payload and
+one block of disk, and it is the blocks that fill a disk, so the cap accounts for every file at
+`max(size, cacheBlockBytes)`.
+-/
+private def cacheBlockBytes : UInt64 := 4096
+
+/-- True if there is room to write; `false` only when the floor is set and the disk is below it. -/
+private def cacheFloorOk (dir : System.FilePath) (b : CacheBound) : IO Bool := do
+  if b.minFree == 0 then return true
+  let free ← try cacheFreeSpaceOf dir.toString catch _ => pure 0
+  -- `0` means the query failed: unknown is not a reason to stop writing.
+  return free == 0 || free ≥ b.minFree
+
+/--
+Opt-in accounting. With `LEAN_CACHE_STATS=<file>` every decision appends one short line to that
+file; concurrent `O_APPEND` writes of a few bytes do not interleave, so a whole build's activity
+can be counted afterwards. Unset — the default — this costs one `getenv`.
+-/
+private def cacheStats (line : String) : IO Unit := do
+  if let some f ← IO.getEnv "LEAN_CACHE_STATS" then
+    try
+      let h ← IO.FS.Handle.mk f .append
+      h.putStr (line ++ "\n")
+    catch _ => pure ()
+
+/-- Rewrites the one-byte `.used` stamp beside `path`, which is the entry's LRU recency. -/
+private def cacheTouch (path : System.FilePath) : IO Unit := do
+  try IO.FS.writeBinFile (path.addExtension "used") ⟨#[0]⟩ catch _ => pure ()
+
+/-- `SystemTime`'s `<` is a `Prop`; the LRU sort needs a `Bool`. -/
+private def cacheTimeLt (a b : IO.FS.SystemTime) : Bool :=
+  a.sec < b.sec || (a.sec == b.sec && a.nsec < b.nsec)
+
+private structure CacheEntry where
+  base    : String
+  files   : Array System.FilePath := #[]
+  bytes   : UInt64 := 0
+  modified : IO.FS.SystemTime := ⟨0, 0⟩
+
+/--
+Enforces the size cap: one `readDir` plus one `stat` per file, then removal of whole entries
+oldest-first until the total is under the cap. Files belonging to a write in flight (`.tmp<pid>`,
+`.probe<pid>`) are skipped, and every removal is best-effort — a loser of a race just finds the
+file gone. Unlinking a file another process has mapped is safe on POSIX; on Windows it fails and
+is ignored. Returns the number of entries evicted, the bytes they held, and the total afterwards.
+-/
+private def cacheEnforceCap (dir : System.FilePath) (b : CacheBound) :
+    IO (Nat × UInt64 × UInt64) := do
+  if b.maxSize == 0 then return (0, 0, 0)
+  let entries ← try dir.readDir catch _ => pure #[]
+  let mut groups : Std.HashMap String CacheEntry := {}
+  for e in entries do
+    let name := e.fileName
+    -- skip another process's temporaries (`<file>.tmp<pid>`, `<file>.probe<pid>`)
+    let ext := (System.FilePath.mk name).extension.getD ""
+    if ext.startsWith "tmp" || ext.startsWith "probe" then continue
+    let base :=
+      if name.endsWith ".used" || name.endsWith ".deps" then (name.dropEnd 5).toString else name
+    let md ← try pure (some (← e.path.metadata)) catch _ => pure none
+    let some md := md | continue
+    unless md.type == .file do continue
+    let g := groups.getD base { base }
+    groups := groups.insert base
+      { g with
+        files := g.files.push e.path
+        bytes := g.bytes + max md.byteSize cacheBlockBytes
+        modified := if cacheTimeLt g.modified md.modified then md.modified else g.modified }
+  let mut total : UInt64 := 0
+  for (_, g) in groups do
+    total := total + g.bytes
+  if total ≤ b.maxSize then return (0, 0, total)
+  let mut arr := groups.toArray.map (·.2)
+  arr := arr.qsort fun a b => cacheTimeLt a.modified b.modified
+  let mut evicted := 0
+  let mut freed : UInt64 := 0
+  for g in arr do
+    if total ≤ b.maxSize then break
+    for f in g.files do
+      try IO.FS.removeFile f catch _ => pure ()
+    total := total - min total g.bytes
+    freed := freed + g.bytes
+    evicted := evicted + 1
+  return (evicted, freed, total)
+
+/--
+Admission (`min_uses`). Returns `true` if this sighting of `key` may write the payload. At
+`minUses ≤ 1` this is unconditionally `true` and no marker is created, so the default costs
+nothing and behaves exactly as before. Otherwise `<markerPfx><key>` records one byte per sighting
+and its size is the count.
+
+Markers are the only thing a `min_uses ≥ 2` run writes, so the cap has to reach them too; but a
+scan per marker would be quadratic in the number of closures, so one marker write in 64 (chosen by
+the key's hash) enforces it. That keeps the cost at 1/64 of a scan per miss and still bounds the
+directory.
+-/
+private def cacheAdmit (dir : System.FilePath) (markerPfx : String) (key : String)
+    (b : CacheBound) : IO Bool := do
+  if b.minUses ≤ 1 then return true
+  let p := dir / (markerPfx ++ key)
+  let seen ← try pure (← p.metadata).byteSize.toNat catch _ => pure 0
+  if seen + 1 ≥ b.minUses then return true
+  try
+    IO.FS.createDirAll dir
+    let h ← IO.FS.Handle.mk p .append
+    h.write ⟨#[0]⟩
+    if hash key % 64 == 0 then
+      let _ ← cacheEnforceCap dir b
+  catch _ => pure ()
+  return false
+
+/-!
+### Tactic index: a shipped image of the eager extension indexes
+
+`finalizePersistentExtensions` runs every persistent extension's `addImportedFn` at every start;
+for the *eager* (scoped) ones this rebuilds an in-heap index — `simp`'s `DiscrTree` (99,657
+entries), the instance `DiscrTree` (43,515), the LCNF specialization cache, `grind`, the
+match-equation table, Mathlib's `to_additive`/`fun_prop`/`gcongr`/`norm_num`/`positivity` tables —
+from data that has not changed since the last start.
+
+The tactic index puts those states into **one compacted region per import closure** whose dependency regions are
+the closure's `.olean` regions, so nothing that already lives in an `.olean` is copied. When such an
+image is present, the import memory-maps it and installs each state as the extension's imported
+state instead of running `addImportedFn`. The installed value is the compacted image of exactly the
+object graph the eager path builds, so `simp`'s `DiscrTree` has the same shape and the same per-key
+insertion order by construction.
+
+**The two halves are separate, and only reading is automatic.**
+
+* *Reading* is what every ordinary run does: look for `exts-<key>.tacticindex` in the image directory, and
+  if it is there and its key matches, map it. If it is absent, mismatched or unreadable, the import
+  rebuilds the indexes exactly as stock Lean does. A run never writes, never creates a directory
+  and never evicts anything.
+* *Writing* happens only when `LEAN_TACTIC_INDEX_WRITE` is set, which is a deliberate act by whoever
+  distributes a library — Mathlib's CI next to `lake exe cache`, or a user once for the header they
+  work under. It is the same probe-and-save the cache used to run automatically on every miss.
+
+An earlier revision wrote on every miss, into `$HOME/.cache/lean-tactic-index`. That made it a cache,
+and every problem it had was a cache problem: a from-source Mathlib build wrote 255 GiB of images
+to answer 216 lookups, and the size cap and admission threshold added to bound it could not be given
+defensible defaults (one of them cost 19 % on a real project). The measured *benefit*, meanwhile,
+is confined to one workload — a fixed import line, one closure, one image. Serving that with a
+prebuilt artefact keeps the benefit and deletes the policy.
+
+**Where the image lives.** By default, in the directory of the topmost module's `.olean` — i.e. the
+`lib/lean` directory of the library that owns the closure (`.lake/build/lib/lean` for a Lake
+package). An image is valid for exactly one (toolchain, library revision) pair, which is the same
+thing an olean cache is keyed on, so it belongs in the same place and travels the same way.
+`LEAN_TACTIC_INDEX_DIR` overrides that, for reading and for writing alike, for anyone who prefers to
+stage images elsewhere.
+
+**Why a stale image cannot be used.** The image's dependency regions *are* the `.olean` regions it
+was built against; `CompactedRegion.read` fails if they do not match, and the key stored inside the
+image (closure module names in `ModuleIdx` order, every region's path and size, and the number of
+imported entries every extension sees) is re-checked against the key computed now. Either check
+failing means the image is ignored and the indexes are rebuilt — a slow correct run, not a wrong
+answer.
+
+Switches: `LEAN_TACTIC_INDEX=0` (off, stock behaviour), `LEAN_TACTIC_INDEX_DIR=<dir>` (where images are read
+from and written to), `LEAN_TACTIC_INDEX_WRITE=1` (build and write the image for this closure, then
+continue), `LEAN_TACTIC_INDEX_VERBOSE=1`. `LEAN_CACHE_STATS=<file>` appends one `tactic-index hit|miss|write <key>`
+line per import, which is how a distributor learns which closures its users present.
+
+Inside `finalizePersistentExtensions` — upstream code — the whole feature is one branch.
+-/
+
+/-- Tactic index: extensions that are never put into an image (their states hold evaluated closures). -/
+private def tacticIndexNeverDefer : Std.HashMap Name Unit :=
+  #[`Lean.regularInitAttr, `Lean.builtinInitAttr, `Lean.Parser.parserExtension,
+    `Lean.Elab.macroAttribute, `Lean.Elab.Term.termElabAttribute, `Lean.Elab.Command.commandElabAttribute,
+    `Lean.Elab.Tactic.tacticElabAttribute, `Lean.attributeExtension].foldl (·.insert · ()) {}
+
+/-- Tactic index: the format version of the extension-state image; bump on any change of what is stored. -/
+private def tacticIndexImageVersion : UInt64 := 1
+
+/-- Tactic index: extension states whose compacted image is smaller than this are not worth mapping. -/
+private def tacticIndexMinStateBytes : UInt64 := 4096
+
+/-- Tactic index: the root object of an image file. -/
+structure TacticIndexImage where
+  key         : UInt64 := 0
+  moduleNames : Array Name := #[]
+  extNames    : Array Name := #[]
+  states      : Array EnvExtensionState := #[]
+  deriving Inhabited
+
+/--
+Tactic index: image regions kept alive for the lifetime of the process. The environment is leaked anyway
+(`leakEnv`), and the states installed from an image point into its region, so it must never be
+unmapped. It is deliberately *not* added to `EnvironmentHeader.regions`: that array is the
+dependency list used to save and load the image, and must be the same on both sides.
+-/
+private builtin_initialize tacticIndexRegions : IO.Ref (Array CompactedRegion) ← IO.mkRef #[]
+
+/--
+Tactic index: image key. Covers the closure (module names in `ModuleIdx` order), the identity of every
+mapped region (path and size — the size comes from the `fstat` of *this* process, so it is current)
+and the number of imported entries the imaged extensions see (which reflects the lazy-parts mode and any
+change of attribute data). It is both the file name and a field of the image, so a mismatched
+image is rejected rather than installed.
+-/
+private def tacticIndexKey (moduleNames : Array Name) (regions : Array CompactedRegion)
+    (extEntryCounts : Array (Name × Nat)) : UInt64 := Id.run do
+  let mut h : UInt64 := mixHash 11 tacticIndexImageVersion
+  h := mixHash h (hash moduleNames.size)
+  for n in moduleNames do
+    h := mixHash h n.hash
+  for r in regions do
+    h := mixHash (mixHash h (hash r.filePath.toString)) (hash r.size.toNat)
+  for (n, c) in extEntryCounts do
+    h := mixHash (mixHash h n.hash) (hash c)
+  return h
+
+private unsafe def tacticIndexLoadImage (path : System.FilePath) (deps : Array CompactedRegion)
+    (verbose := false) : IO (Option (TacticIndexImage × CompactedRegion)) := do
+  unless ← path.pathExists do return none
+  try
+    return some (← CompactedRegion.read (α := TacticIndexImage) path deps)
+  catch e =>
+    if verbose then IO.eprintln s!"tactic-index: image {path} not readable ({deps.size} deps): {e}"
+    return none
+
+/--
+Tactic index: the dependency-region list is stored next to the image as one byte per region of
+`EnvironmentHeader.regions` (in order), because it must be reconstructed *before* the image itself
+can be read.
+
+Only regions that landed at their saved address are used as dependencies: `region_reader` takes
+its fast path — no pointer fixup, no page of the image touched — only when the image itself and
+*every* dependency region is at its saved address, and a Mathlib import has ~38 regions that
+collide and fall back to `read()`. Objects the imaged states hold in those few regions are copied
+into the image instead.
+-/
+private def tacticIndexDepsPath (path : System.FilePath) : System.FilePath := path.addExtension "deps"
+
+private def tacticIndexWriteDeps (path : System.FilePath) (regions : Array CompactedRegion) : IO Unit :=
+  IO.FS.writeBinFile (tacticIndexDepsPath path)
+    ⟨regions.map fun r => (if r.isMemoryMapped then 1 else 0 : UInt8)⟩
+
+/--
+`none` when there is no usable sidecar — the file is missing, or it does not have one byte per
+region of this closure. That is *not* the same as an empty dependency list: an image read with the
+wrong dependencies can still succeed, because the fast path performs no fixup at all, and then the
+cross-region pointers it hands back are only correct by the accident of every region having landed
+at its saved address. An image without its matching sidecar must not be used.
+-/
+private def tacticIndexReadDeps (path : System.FilePath) (regions : Array CompactedRegion) :
+    IO (Option (Array CompactedRegion)) := do
+  let p := tacticIndexDepsPath path
+  unless ← p.pathExists do return none
+  let bs ← IO.FS.readBinFile p
+  if bs.size != regions.size then return none
+  return some <| regions.zipIdx.filterMap fun (r, i) => if bs[i]! == 1 then some r else none
+
+/--
+Tactic index: write the image and its sidecar, and verify that they read back.
+
+`CompactedRegion.save` derives a region's saved base address from a hash of the `key` name it is
+given, and `region_reader` refuses an image whose saved range overlaps a dependency's saved range
+(it could not then tell which region a pointer belongs to). A 212 MB image against ~10,500 olean
+dependencies hits that on the order of one name in sixty, and it is a property of the *saved*
+addresses, so a name that collides collides in every reader, for ever. A distributor must not ship
+an image nobody can read: try `_tacticIndexImage0`, `_tacticIndexImage1`, … until the image reads back through the
+reader's own path, and delete the file rather than leave an unusable one behind. (The name is not
+recorded anywhere — `CompactedRegion.read` takes the base address from the file header — so the
+reader neither knows nor needs to know which attempt succeeded.)
+-/
+private unsafe def tacticIndexSaveImage (path : System.FilePath) (deps regions : Array CompactedRegion)
+    (c : TacticIndexImage) (verbose := false) : IO Bool := do
+  if let some dir := path.parent then IO.FS.createDirAll dir
+  for attempt in *...8 do
+    let tmp := path.addExtension s!"tmp{← IO.Process.getPID}"
+    try
+      let _ ← CompactedRegion.save tmp (Name.mkSimple s!"_tacticIndexImage{attempt}") c deps none
+      IO.FS.rename tmp path
+    catch e =>
+      try IO.FS.removeFile tmp catch _ => pure ()
+      throw e
+    tacticIndexWriteDeps path regions
+    if let some deps ← tacticIndexReadDeps path regions then
+      if (← tacticIndexLoadImage path deps verbose).isSome then
+        return true
+    if verbose then
+      IO.eprintln s!"tactic-index: base address of `_tacticIndexImage{attempt}` collides with a dependency; retrying"
+  try IO.FS.removeFile path catch _ => pure ()
+  try IO.FS.removeFile (tacticIndexDepsPath path) catch _ => pure ()
+  return false
+
+/-- Reads `fnames` as a chain of parts continuing the already loaded `deps`. -/
+private def lazyPartsReadPartsWithDeps (fnames : Array System.FilePath) (deps : Array CompactedRegion) :
+    IO (Array (ModuleData × CompactedRegion)) := do
+  let mut depRegions := deps
+  let mut result := #[]
+  for fname in fnames do
+    let part ← unsafe CompactedRegion.read (α := ModuleData) fname depRegions
+    result := result.push part
+    depRegions := depRegions.push part.2
+  return result
+
+private def lazyPartsEntriesMap (data : ModuleData) : Std.HashMap Name (Array EnvExtensionEntry) :=
+  data.entries.foldl (init := Std.HashMap.emptyWithCapacity data.entries.size) fun m (n, es) =>
+    m.insert n es
+
+/-- `subsumesInfo` with an arbitrary lookup function. -/
+private def lazyPartsSubsumes (find? : Name → Option ConstantInfo) (cinfo₁ cinfo₂ : ConstantInfo) : Bool :=
+  cinfo₁.name == cinfo₂.name &&
+    cinfo₁.type == cinfo₂.type &&
+    cinfo₁.levelParams == cinfo₂.levelParams &&
+    match cinfo₁, cinfo₂ with
+    | .thmInfo tval₁, .thmInfo tval₂ => tval₁.all == tval₂.all
+    | .thmInfo tval₁, .axiomInfo aval₂ => tval₁.all == [aval₂.name] && !aval₂.isUnsafe
+    | .axiomInfo aval₁, .axiomInfo aval₂ => aval₁.isUnsafe == aval₂.isUnsafe && isPropCheap aval₁.type
+    | _, _ => false
+where
+  isPropCheap (ty : Expr) : Bool := Id.run do
+    let mut ty := ty
+    while ty.isForall do
+      let .forallE (body := body) .. := ty | return false
+      ty := body
+    let .const n .. := ty.getAppFn | return false
+    let some decl := find? n | return false
+    let mut p := decl.type
+    for _ in 0...ty.getAppNumArgs do
+      let .forallE (body := body) .. := p | return false
+      p := body
+    p.isProp
+
+/-- Loads module `m`'s `.olean.server`/`.olean.private` parts and merges its constants and entries. -/
+private def lazyPartsLoadPriv (ref : IO.Ref LazyPartsState) (m : Nat) (reason : Name) : IO Unit := do
+  let s ← ref.get
+  if (s.privEntries[m]?.getD none).isSome then return
+  let some mod := s.mods[m]? | return
+  if mod.privFiles.isEmpty then return
+  if s.verbose then IO.eprintln s!"lazy-parts: loading private part of {s.moduleNames[m]!} (for {reason})"
+  let parts ← lazyPartsReadPartsWithDeps mod.privFiles mod.privDeps
+  let some (priv, _) := parts.back? | return
+  let emap := lazyPartsEntriesMap priv
+  ref.modify fun s => Id.run do
+    if (s.privEntries[m]?.getD none).isSome then return s  -- lost a race; keep the first load
+    let base := s.overlay
+    let exported := s.exported
+    let find? (n : Name) : Option ConstantInfo := base.find? n <|> exported[n]?
+    let mut overlay := s.overlay
+    let mut numOverlay := s.numOverlay
+    for h : i in *...(min priv.constNames.size priv.constants.size) do
+      have hc : i < priv.constants.size := Nat.lt_of_lt_of_le (Std.Rio.lt_upper_of_mem h) (Nat.min_le_right ..)
+      have hn : i < priv.constNames.size := Nat.lt_of_lt_of_le (Std.Rio.lt_upper_of_mem h) (Nat.min_le_left ..)
+      let cname := priv.constNames[i]
+      match overlay.find? cname with
+      | none =>
+        overlay := overlay.insert cname (getPersistentElem priv.constants i hc)
+        numOverlay := numOverlay + 1
+      | some cinfoPrev =>
+        -- duplicate constant (e.g. an equation theorem realized in two modules), rare
+        let cinfo := priv.constants[i]
+        if lazyPartsSubsumes find? cinfo cinfoPrev then
+          overlay := overlay.insert cname cinfo
+    return { s with
+      overlay
+      numOverlay
+      privEntries := s.privEntries.set! m (some emap)
+      regions := s.regions ++ parts.map (·.2)
+      numPrivLoads := s.numPrivLoads + 1 }
+
+/-- Loads module `m`'s `.ir.sig`/`.ir` parts. -/
+private def lazyPartsLoadIR (ref : IO.Ref LazyPartsState) (m : Nat) (reason : Name) : IO Unit := do
+  let s ← ref.get
+  if (s.irEntries[m]?.getD none).isSome then return
+  let some mod := s.mods[m]? | return
+  if mod.irFiles.isEmpty then return
+  if s.verbose then IO.eprintln s!"lazy-parts: loading IR of {s.moduleNames[m]!} (for {reason})"
+  let parts ← lazyPartsReadPartsWithDeps mod.irFiles #[]
+  let some (ir, _) := parts.back? | return
+  let emap := lazyPartsEntriesMap ir
+  ref.modify fun s =>
+    if (s.irEntries[m]?.getD none).isSome then s
+    else { s with
+      irEntries := s.irEntries.set! m (some emap)
+      regions := s.regions ++ parts.map (·.2)
+      numIRLoads := s.numIRLoads + 1 }
+
+private def lazyPartsGetState (lazyId : Nat) : BaseIO (Option (IO.Ref LazyPartsState)) := do
+  return (← lazyPartsRegistry.get)[lazyId - 1]?
+
+private unsafe def lazyPartsModuleEntriesImpl (lazyId : Nat) (extName : Name) (m : Nat) (ir : Bool) :
+    Option (Array EnvExtensionEntry) := unsafeBaseIO do
+  let some ref ← lazyPartsGetState lazyId | return none
+  let s ← ref.get
+  let some mod := s.mods[m]? | return none
+  if ir then
+    -- only `declMapExt` lives exclusively in the `.ir` part; the other IR entries come from the index
+    if mod.irFiles.isEmpty || extName != lazyPartsDeclMapExtName then return none
+    if (s.irEntries[m]?.getD none).isNone then
+      let _ ← (lazyPartsLoadIR ref m extName).toBaseIO
+    let s ← ref.get
+    return some (((s.irEntries[m]?.getD none).bind (·[extName]?)).getD #[])
+  else
+    if !s.lazyPrivate || mod.privFiles.isEmpty || !lazyPartsLazyExtNames.contains extName then return none
+    if (s.privEntries[m]?.getD none).isNone then
+      let _ ← (lazyPartsLoadPriv ref m extName).toBaseIO
+    let s ← ref.get
