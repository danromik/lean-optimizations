+
+private unsafe def lazyPartsResolveConstImpl (lazyId : Nat) (const2ModIdx : Std.HashMap Name ModuleIdx)
+    (n : Name) (c? : Option ConstantInfo) : Option ConstantInfo := unsafeBaseIO do
+  let some ref ← lazyPartsGetState lazyId | return c?
+  let s ← ref.get
+  if !s.lazyPrivate then return c?
