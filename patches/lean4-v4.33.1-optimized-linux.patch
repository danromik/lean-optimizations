+/-! ## Prebuilt per-module library-search index
+
+The root discrimination-tree key of every constant's type is computed once, when the module is
+elaborated (`recordModuleIndex`, called by the frontend before the `.olean` is written), and stored
+in the module as `IndexEntry`s. The first `exact?`/`apply?` of a process then only merges the
+stored entries of the imported modules (`prebuiltEntries`) instead of walking every imported
+constant's type through `whnfR` and `inferType`; modules without stored entries (built by a
+toolchain without this extension, or before it is available in the import chain) fall back to the
+walk. The set and order of entries is the same as the walk's: `recordModuleIndex` visits the
+module's constants in `mkModuleData` order and applies the same filters; the parts of
+`blacklistInsertion` that depend on the importing environment (`_private` names are candidates
+only for a root with `import all`) are re-applied at import time. Deprecation (`isDeprecated`) and
+reducibility are fixed when a module is written (both attributes can only be set in the defining
+module; `attribute [local reducible]` in the root is the one situation where the stored key can
+differ from a key recomputed in the root — stock computes its process-global tree in whatever
+context the first `exact?` runs in, so this is at most as context-dependent as before).
+-/
+
+/-- One entry of the prebuilt library-search index of a module. -/
+structure IndexEntry where
+  name : Name
+  key  : LazyDiscrTree.Key
+  mod  : DeclMod
+  /-- the first `LazyDiscrTree.prefixDepth` keys below the root -/
+  pfx : Array LazyDiscrTree.Key := #[]
+  /-- the path ends after `pfx` -/
+  complete : Bool := false
+  deriving Inhabited
+
+builtin_initialize indexExt : SimplePersistentEnvExtension IndexEntry (Array IndexEntry) ←
+  registerSimplePersistentEnvExtension {
+    addEntryFn := Array.push
+    addImportedFn := fun _ => #[]
+  }
+
+/-- `LEAN_SEARCH_INDEX=0` ignores stored index entries (walk every constant, as stock). -/
+builtin_initialize searchIndexPrebuilt : Bool ←
+  return (← IO.getEnv "LEAN_SEARCH_INDEX") != some "0"
+
+/-- `LEAN_SEARCH_INDEX_RECORD=0` writes no index entries. -/
+builtin_initialize searchIndexRecord : Bool ←
+  return (← IO.getEnv "LEAN_SEARCH_INDEX_RECORD") != some "0"
+
+/--
+Compute the library-search index entries of the current module (root keys of the types of
+its constants) and add them to the environment, so that they are written to the `.olean`.
+-/
+def recordModuleIndex (env : Environment) (opts : Options) : IO Environment := do
+  if !searchIndexRecord then return env
+  let kenv := env.toKernelEnv
+  -- same order as the `constants` array `mkModuleData` writes at the `.private` level
+  let consts := kenv.constants.foldStage2 (fun cs _ c => cs.push c) #[]
+  let cctx : Core.Context := {
+    fileName := "<librarySearchIndex>", fileMap := default, options := opts, maxHeartbeats := 0 }
+  let mctx : Meta.Context := {
+    keyedConfig := Meta.Config.toConfigWithKey { transparency := .reducible } }
+  let go : MetaM (Array IndexEntry) := do
+    let mut out := #[]
+    for c in consts do
+      if c.isUnsafe then continue
+      if LazyDiscrTree.blacklistInsertion env c.name then continue
+      let es ← try addImport c.name (.ofConstantInfo c) catch _ => pure #[]
+      for e in es do
+        let (pfx, complete) ← try e.entry.keyPrefix catch _ => pure (#[], false)
+        out := out.push { name := c.name, key := e.key, mod := e.entry.value.2, pfx, complete }
+    return out
+  let (entries, _, _) ← go.toIO cctx { env } mctx {}
+  return entries.foldl (fun env e => indexExt.addEntry env e) env
